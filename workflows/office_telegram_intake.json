      "parameters": {
        "jsCode": "const update = $input.first().json;\nconst msg = update.message;\nif (msg?.chat?.type !== 'private' || typeof msg.text !== 'string' || !msg.from?.id) return [];\nreturn [{json:{userId:String(msg.from.id),chatId:String(msg.chat.id),updateId:String(update.update_id),text:msg.text}}];"
      },
      "id": "0d8191fd-ea65-4f95-902b-000000000002",
      "name": "Pesan pribadi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://REPLACE-WITH-AUTHORIZED-HTTPS-HOST/api/integrations/telegram",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "0d8191fd-ea65-4f95-902b-000000000003",
      "name": "Validasi dan proses",
