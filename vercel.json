{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/route.ts": {
      "includeFiles": "{server/**,public/catalog.js,public/behavior.js}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/route?path=:path*"
    }
  ]
}
